generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())

  name        String
  description String?

  address String?

  icalUrl String?

  isActive Boolean @default(true)

  email    String @unique
  password String

  settings Settings?

  properties Property[]

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  id String @id @default(uuid())

  name    String
  icalUrl String?

  isActive Boolean @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  reservations Reservation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

enum ReservationSource {
  AIRBNB
  DIRECT
  BLOCKED
}

model Reservation {
  id String @id @default(uuid())

  title String

  startDate DateTime
  endDate   DateTime

  source ReservationSource

  externalId String?

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([externalId, propertyId])
}

model Settings {
  id String @id @default(uuid())

  language String @default("fr")

  timezone String @default("Africa/Abidjan")

  syncInterval Int @default(60)

  autoSyncEnabled Boolean @default(true)

  notificationsEnabled Boolean @default(true)

  lastSyncAt DateTime?

  userId String @unique

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id String @id @default(uuid())

  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  expiresAt DateTime

  createdAt DateTime @default(now())
}
